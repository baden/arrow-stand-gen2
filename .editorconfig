root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,h}]
indent_size = 4
max_line_length = 100

[*.{py,js,ts,json,jsonc}]
indent_size = 2

[*.{yml,yaml,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
indent_size = 2

[*.{kicad_sch,kicad_pcb,kicad_pro,kicad_sym,kicad_mod}]
insert_final_newline = false
trim_trailing_whitespace = false
# KiCAD керує власним форматуванням

[Makefile]
indent_style = tab

[*.csv]
insert_final_newline = true
