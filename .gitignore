# --- KiCAD ---
# ВАЖЛИВО: проєктні бібліотеки обов'язково комітяться — без них схема й PCB
# не відкриваються на іншій машині:
#   hardware/target/arrowstand.kicad_sym   (символи з LCSC/EasyEDA)
#   hardware/target/arrowstand.pretty/     (футпрінти з LCSC/EasyEDA)
*.kicad_prl
*.lck
*.bak
*~
*-backups/
_autosave-*
fp-info-cache
*.net
*.kicad_pcb-bak
*.kicad_sch-bak
*.kicad_pro-bak

# Тимчасові артефакти перевірок (kicad-cli sch erc / export netlist)
erc_*.json
*_check.net
*_head_check.kicad_sch

# --- Copperpour ---
.copperpour/baselines/
.copperpour/cache/
.copperpour/*.log

# --- Виробництво / експорт ---
hardware/*/gerbers/
hardware/*/fab/
hardware/assembly/*.csv
hardware/bom/bom.csv
hardware/bom/pickplace.csv
docs/snapshots/
*.pdf
!docs/**/*.pdf

# --- Прошивка ---
firmware/build/
firmware/*.elf
firmware/*.bin
firmware/*.hex
firmware/*.map
firmware/*.size
firmware/.cache/

# --- Інструменти ---
tools/__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# --- Загальне ---
.DS_Store
Thumbs.db
.env
.env.*
*.log
