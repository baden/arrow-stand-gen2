(footprint "LiPo_LP802023_240mAh"
  (version 20240108)
  (generator "copperpour")
  (layer "F.Cu")
  (descr "LiPo LP802023 (240 mAh, 3.7 V, 8x20x23 mm) battery LEAD HOLES: two plated holes 0.7 mm for the cut wires (pad 1 = BAT+ red, pad 2 = BAT- black), spaced 4 mm. The battery cell is NOT part of the footprint graphics - the wires are flexible, the holes may be placed anywhere on the PCB and the cell is glued separately. The 3D model is attached for reference only; set its position manually as needed.")
  (attr through_hole)
  (pad "1" thru_hole circle (at 0 2) (size 1.5 1.5) (layers "*.Cu" "*.Mask") (drill 0.7) )
  (pad "2" thru_hole circle (at 0 -2) (size 1.5 1.5) (layers "*.Cu" "*.Mask") (drill 0.7) )
  (fp_rect (start -1.2500 -3.2500) (end 1.2500 3.2500) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
  (fp_circle (center 0 3.3) (end 0.15 3.3) (stroke (width 0.1) (type solid)) (fill solid) (layer "F.SilkS"))
  (fp_line (start 1.6 2) (end 3.4 2) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
  (fp_line (start 2.5 1.1) (end 2.5 2.9) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
  (fp_line (start 1.6 -2) (end 3.4 -2) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
  (fp_poly (pts (xy -1.5000 -3.5000) (xy 1.5000 -3.5000) (xy 1.5000 3.5000) (xy -0.7500 3.5000) (xy -1.5000 2.7500)) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
  (fp_text reference "REF**" (at 0.0000 -4.2500 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value "LiPo_LP802023_240mAh" (at 0.0000 4.2500 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
  (model "${KIPRJMOD}/packages3d/LiPo_LP802023_240mAh_8x20x23.step"
    (offset (xyz 0 0 0))
    (scale (xyz 1 1 1))
    (rotate (xyz 0 0 0))
  )
)